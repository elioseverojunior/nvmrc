    on_intel do
      url "@URL@/nvmrc-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "nvmrc", "nvm", "nvm-exec"
  end

  test do
    assert_equal "nvm #{version}", shell_output("#{bin}/nvm --version").strip
